{
  "openapi": "3.1.0",
  "info": {
    "title": "Fagan Nomogram Bayesian Updater API",
    "description": "Bayesian post-test probability API with separate unvalidated demonstration supervisor endpoints.",
    "version": "3.1.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Service reachable"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "JSON demonstration supervisor metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Air-gapped supervisory conversational assistant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/calculate": {
      "post": {
        "summary": "Calculate Bayesian post-test probability",
        "description": "All probabilities, sensitivity and specificity are 0–100 percentages. Provide either likelihood_ratio or both sensitivity and specificity.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pretest_probability": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "likelihood_ratio": {
                    "type": "number",
                    "minimum": 0
                  },
                  "sensitivity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "specificity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "positive",
                      "negative"
                    ],
                    "default": "positive"
                  }
                },
                "required": [
                  "pretest_probability"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post-test probability, likelihood ratio and odds"
          },
          "422": {
            "description": "Invalid or undefined Bayesian input"
          }
        }
      }
    }
  }
}
